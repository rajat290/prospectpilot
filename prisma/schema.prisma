generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadSources        LeadSource[]
  notes              Note[]
  channelConnections ChannelConnection[]
}

model FounderProfile {
  id                   String                 @id @default(cuid())
  displayName          String                 @default("Rajat Tomar")
  missionName          String                 @default("Freedom Mission")
  missionTargetAmount  Int                    @default(10000000)
  disciplineMode       FinancialDisciplineMode @default(ADVISORY)
  privacyModeEnabled   Boolean                @default(false)
  reducedMotionEnabled Boolean                @default(false)
  soundEnabled         Boolean                @default(false)
  timezone             String                 @default("Asia/Kolkata")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  milestones         MissionMilestone[]
  xpLedger           XpLedger[]
  dailyQuests        DailyQuest[]
  streak             FounderStreak?
  earnedAchievements EarnedAchievement[]
  celebrations       CelebrationEvent[]
  rewardWallet       RewardWallet?
  rewardTransactions RewardTransaction[]
  snapshots          FinancialSnapshot[]
  debtAccounts       DebtAccount[]
  debtPayments       DebtPayment[]
  allocations        MissionAllocation[]
  assetRecords       AssetRecord[]
}

model MissionMilestone {
  id              String        @id @default(cuid())
  profileId       String
  milestoneKey    String        @unique
  title           String
  description     String
  targetAmount    Int
  allocatedAmount Int           @default(0)
  status          MissionStatus @default(LOCKED)
  sortOrder       Int
  icon            String
  rewardXp        Int           @default(1000)
  rewardCoins     Int           @default(250)
  note            String?
  completedAt     DateTime?
  verifiedAt      DateTime?
  evidenceUrl     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  profile     FounderProfile      @relation(fields: [profileId], references: [id])
  allocations MissionAllocation[]
  assetRecords AssetRecord[]

  @@index([profileId, sortOrder])
  @@index([status])
}

model XpLedger {
  id               String   @id @default(cuid())
  profileId        String
  eventType        String
  sourceEntityType String
  sourceEntityId   String?
  baseXp           Int
  multiplier       Float    @default(1)
  finalXp          Int
  reason           String
  idempotencyKey   String   @unique
  reversedAt       DateTime?
  createdAt        DateTime @default(now())

  profile FounderProfile @relation(fields: [profileId], references: [id])

  @@index([profileId, createdAt])
  @@index([eventType])
}

model AchievementDefinition {
  id          String            @id @default(cuid())
  badgeKey    String            @unique
  name        String
  description String
  icon        String
  category    String
  rarity      AchievementRarity @default(COMMON)
  criteria    Json
  rewardXp    Int               @default(0)
  rewardCoins Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  earned EarnedAchievement[]
}

model EarnedAchievement {
  id             String   @id @default(cuid())
  profileId      String
  definitionId   String
  progress       Int      @default(100)
  evidence       Json?
  earnedAt       DateTime @default(now())

  profile    FounderProfile        @relation(fields: [profileId], references: [id])
  definition AchievementDefinition @relation(fields: [definitionId], references: [id])

  @@unique([profileId, definitionId])
  @@index([profileId, earnedAt])
}

model DailyQuest {
  id           String      @id @default(cuid())
  profileId    String
  questDate    DateTime
  title        String
  description  String
  metricType   String
  targetValue  Int
  currentValue Int         @default(0)
  xpReward     Int
  coinReward   Int
  sourceRule   String
  status       QuestStatus @default(ACTIVE)
  expiresAt    DateTime
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  profile FounderProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, questDate, metricType])
  @@index([status, expiresAt])
}

model FounderStreak {
  id             String    @id @default(cuid())
  profileId      String    @unique
  currentDays    Int       @default(0)
  longestDays    Int       @default(0)
  lastQualifyingAt DateTime?
  freezeCountThisMonth Int  @default(0)
  weekendPauseEnabled Boolean @default(true)
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  profile FounderProfile @relation(fields: [profileId], references: [id])
}

model CelebrationEvent {
  id               String           @id @default(cuid())
  profileId        String
  level            CelebrationLevel
  title            String
  message          String
  sourceEntityType String
  sourceEntityId   String?
  idempotencyKey   String           @unique
  viewedAt         DateTime?
  createdAt        DateTime         @default(now())

  profile FounderProfile @relation(fields: [profileId], references: [id])

  @@index([profileId, createdAt])
  @@index([viewedAt])
}

model RewardWallet {
  id        String   @id @default(cuid())
  profileId String  @unique
  balance   Int     @default(0)
  lifetime  Int     @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  profile FounderProfile @relation(fields: [profileId], references: [id])
}

model RewardTransaction {
  id               String   @id @default(cuid())
  profileId        String
  amount           Int
  reason           String
  sourceEntityType String
  sourceEntityId   String?
  idempotencyKey   String   @unique
  reversedAt       DateTime?
  createdAt        DateTime @default(now())

  profile FounderProfile @relation(fields: [profileId], references: [id])

  @@index([profileId, createdAt])
}

model FinancialSnapshot {
  id                   String   @id @default(cuid())
  profileId            String
  snapshotDate         DateTime
  grossCollectedRevenue Int     @default(0)
  netBusinessCash      Int      @default(0)
  debtRemaining        Int      @default(0)
  liquidReserve        Int      @default(0)
  missionAllocation    Int      @default(0)
  verifiedInvestmentValue Int   @default(0)
  personalNetProgress  Int      @default(0)
  projectionNote       String?
  createdAt            DateTime @default(now())

  profile FounderProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, snapshotDate])
}

model DebtAccount {
  id              String   @id @default(cuid())
  profileId       String
  name            String
  originalAmount  Int
  currentBalance  Int
  priority        Int      @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile  FounderProfile @relation(fields: [profileId], references: [id])
  payments DebtPayment[]

  @@index([profileId, status])
}

model DebtPayment {
  id             String   @id @default(cuid())
  profileId      String
  debtAccountId  String?
  amount         Int
  paidAt         DateTime @default(now())
  evidenceUrl    String?
  note           String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  profile     FounderProfile @relation(fields: [profileId], references: [id])
  debtAccount DebtAccount?   @relation(fields: [debtAccountId], references: [id])

  @@index([profileId, paidAt])
}

model MissionAllocation {
  id             String            @id @default(cuid())
  profileId      String
  milestoneId    String?
  category       FinancialCategory
  amount         Int
  occurredAt     DateTime          @default(now())
  source         String            @default("MANUAL")
  evidenceUrl    String?
  note           String?
  verified       Boolean           @default(false)
  idempotencyKey String            @unique
  reversedAt     DateTime?
  createdAt      DateTime          @default(now())

  profile   FounderProfile   @relation(fields: [profileId], references: [id])
  milestone MissionMilestone? @relation(fields: [milestoneId], references: [id])

  @@index([profileId, occurredAt])
  @@index([category])
}

model AssetRecord {
  id           String   @id @default(cuid())
  profileId    String
  milestoneId  String?
  name         String
  assetType    String
  verifiedValue Int
  acquiredAt   DateTime?
  verifiedAt   DateTime?
  evidenceUrl  String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile   FounderProfile   @relation(fields: [profileId], references: [id])
  milestone MissionMilestone? @relation(fields: [milestoneId], references: [id])

  @@index([profileId, verifiedAt])
}

model LeadSource {
  id                   String       @id @default(cuid())
  userId               String?
  name                 String?
  url                  String       @unique
  sourceType           SourceType   @default(DIRECTORY)
  status               SourceStatus @default(PENDING)
  lastRunAt            DateTime?
  recordCount          Int          @default(0)
  errorMessage         String?
  maxRecords           Int          @default(100)
  requestDelayMs       Int          @default(750)
  automationEnabled    Boolean      @default(false)
  scheduleCron         String       @default("0 8 * * *")
  scheduleTimezone     String       @default("Asia/Kolkata")
  nextRunAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  connectorHealthScore Int          @default(0)
  lastSuccessfulRunAt  DateTime?

  user         User?                      @relation(fields: [userId], references: [id])
  companies    Company[]
  observations CompanySourceObservation[]
  runs         ConnectorRun[]
  jobs         Job[]
}

model Company {
  id                     String                 @id @default(cuid())
  leadSourceId           String?
  name                   String
  normalizedName         String
  websiteUrl             String?
  phone                  String?
  email                  String?
  address                String?
  city                   String?
  region                 String?
  country                String?
  industry               String?
  category               String?
  description            String?
  sourceUrl              String?
  connectorId            String?
  raw                    Json?
  extractionScore        Int                    @default(0)
  identityKey            String?
  trustStatus            VerificationStatus     @default(UNVERIFIED)
  overallConfidence      Int                    @default(0)
  dataCompleteness       Int                    @default(0)
  lastVerifiedAt         DateTime?
  quarantinedAt          DateTime?
  quarantineReason       String?
  status                 CompanyStatus          @default(NEW)
  websiteDiscoveryStatus WebsiteDiscoveryStatus @default(PENDING)
  websiteDiscoveryError  String?
  websiteDiscoveryAt     DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  leadSource               LeadSource?                @relation(fields: [leadSourceId], references: [id])
  website                  Website?
  contacts                 Contact[]
  socials                  Social[]
  technologies             Technology[]
  audits                   WebsiteAudit[]
  opportunities            Opportunity[]
  leadScore                LeadScore?
  outreachDrafts           OutreachDraft[]
  crmItem                  CrmItem?
  notes                    Note[]
  activities               Activity[]
  evidence                 EvidenceRecord[]
  qualityIssues            DataQualityIssue[]
  sourceObservations       CompanySourceObservation[]
  conversations            Conversation[]
  messages                 Message[]
  suppressions             SuppressionEntry[]
  communicationPreferences CommunicationPreference[]
  sequenceEnrollments      SequenceEnrollment[]
  inboundReviews           InboundReview[]          @relation("InboundReviewCompany")
  replyIntelligence        ReplyIntelligence[]
  recommendedActions       RecommendedAction[]
  objections               ConversationObjection[]
  meetingIntents           MeetingIntent[]
  suggestedReplies         SuggestedReply[]
  salesTasks               SalesTask[]
  aiRuns                   AiRun[]

  @@unique([leadSourceId, normalizedName])
  @@index([normalizedName])
  @@index([identityKey])
  @@index([trustStatus])
  @@index([websiteUrl])
}

model Website {
  id              String             @id @default(cuid())
  companyId       String             @unique
  url             String
  finalUrl        String?
  title           String?
  metaDescription String?
  discoveryScore  Int                @default(0)
  isVerified      Boolean            @default(false)
  trustStatus     VerificationStatus @default(UNVERIFIED)
  sourceUrl       String?
  lastVerifiedAt  DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt

  company                 Company                   @relation(fields: [companyId], references: [id])
}

model Contact {
  id                      String              @id @default(cuid())
  companyId               String
  type                    ContactType
  value                   String
  label                   String?
  sourceUrl               String?
  confidence              Int                 @default(0)
  normalizedValue         String?
  trustStatus             VerificationStatus  @default(UNVERIFIED)
  isPrimary               Boolean             @default(false)
  lastVerifiedAt          DateTime?
  contactabilityState     ContactabilityState @default(UNKNOWN)
  contactabilityUpdatedAt DateTime?
  doNotContact            Boolean             @default(false)
  bounceCount             Int                 @default(0)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @default(now()) @updatedAt

  company                  Company                   @relation(fields: [companyId], references: [id])
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  messageRecipients        MessageRecipient[]
  suppressions             SuppressionEntry[]
  sequenceEnrollments      SequenceEnrollment[]
  communicationPreferences CommunicationPreference[]
  inboundReviews           InboundReview[]          @relation("InboundReviewContact")

  @@unique([companyId, type, value])
  @@index([value])
}

model Social {
  id             String             @id @default(cuid())
  companyId      String
  platform       SocialType
  url            String
  sourceUrl      String?
  confidence     Int                @default(0)
  trustStatus    VerificationStatus @default(UNVERIFIED)
  lastVerifiedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, platform, url])
}

model Technology {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  category   String?
  confidence Int      @default(0)
  evidence   String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
}

model WebsiteAudit {
  id                String      @id @default(cuid())
  companyId         String
  url               String
  statusCode        Int?
  hasHttps          Boolean     @default(false)
  hasMobileViewport Boolean     @default(false)
  hasContactForm    Boolean     @default(false)
  hasLiveChat       Boolean     @default(false)
  hasAnalytics      Boolean     @default(false)
  hasCookieBanner   Boolean     @default(false)
  brokenLinkCount   Int         @default(0)
  loadStatus        AuditStatus @default(PENDING)
  summary           String?
  createdAt         DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id])
}

model Opportunity {
  id                 String   @id @default(cuid())
  companyId          String
  category           String
  title              String
  reasoning          String
  recommendedService String
  confidence         Int      @default(0)
  createdAt          DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
}

model LeadScore {
  id        String    @id @default(cuid())
  companyId String    @unique
  score     Int
  band      ScoreBand
  breakdown Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

model OutreachDraft {
  id              String   @id @default(cuid())
  companyId       String
  channel         String
  subject         String?
  body            String
  personalization String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, channel])
}

model CrmItem {
  id             String        @id @default(cuid())
  companyId      String        @unique
  status         PipelineStage @default(NEW)
  priority       ScoreBand?
  tags           String[]
  nextReminderAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

model Note {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  body      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
}

model Activity {
  id        String   @id @default(cuid())
  companyId String
  type      String
  summary   String
  metadata  Json?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
}

model ChannelConnection {
  id                    String                @id @default(cuid())
  userId                String?
  provider              CommunicationProvider
  channel               CommunicationChannel
  emailAddress          String
  displayName           String?
  providerAccountId     String?
  accessTokenEncrypted  String?               @db.Text
  refreshTokenEncrypted String?               @db.Text
  accessTokenExpiresAt  DateTime?
  grantedScopes         String[]
  status                ConnectionStatus      @default(PENDING)
  syncCursor            String?
  watchExpirationAt     DateTime?
  lastSyncedAt          DateTime?
  lastError             String?
  signature             String?               @db.Text
  settings              Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  user          User?          @relation(fields: [userId], references: [id])
  conversations Conversation[]
  messages      Message[]
  inboundReviews InboundReview[]
  connectionEvents ConnectionEvent[]
  sequences        Sequence[]
  campaignLaunches CampaignLaunch[]

  @@unique([provider, emailAddress])
  @@index([status])
}

model Conversation {
  id                       String               @id @default(cuid())
  companyId                String?
  connectionId             String?
  channel                  CommunicationChannel
  providerThreadId         String?
  subject                  String?
  status                   ConversationStatus   @default(OPEN)
  latestMessageAt          DateTime?
  unreadCount              Int                  @default(0)
  aiClassification         String?
  classificationConfidence Int?
  summary                  String?              @db.Text
  nextAction               String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  company      Company?                  @relation(fields: [companyId], references: [id])
  connection   ChannelConnection?        @relation(fields: [connectionId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
  enrollments  SequenceEnrollment[]
  intelligence ReplyIntelligence[]
  intelligenceSummary ConversationSummary?
  recommendedActions RecommendedAction[]
  objections   ConversationObjection[]
  meetingIntents MeetingIntent[]
  suggestedReplies SuggestedReply[]
  salesTasks   SalesTask[]
  aiRuns       AiRun[]

  @@unique([connectionId, providerThreadId])
  @@index([companyId, latestMessageAt])
  @@index([status, latestMessageAt])
}

model ConversationParticipant {
  id                String          @id @default(cuid())
  conversationId    String
  contactId         String?
  name              String?
  address           String
  normalizedAddress String
  role              ParticipantRole
  createdAt         DateTime        @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  contact      Contact?     @relation(fields: [contactId], references: [id])

  @@unique([conversationId, normalizedAddress, role])
  @@index([normalizedAddress])
}

model Message {
  id                   String               @id @default(cuid())
  conversationId       String
  companyId            String?
  contactId            String?
  connectionId         String?
  sequenceEnrollmentId String?
  sequenceStepId       String?
  channel              CommunicationChannel
  direction            MessageDirection
  status               MessageStatus        @default(DRAFT)
  providerMessageId    String?
  providerThreadId     String?
  internetMessageId    String?
  inReplyTo            String?
  references           String[]
  idempotencyKey       String?              @unique
  subject              String?
  bodyText             String               @db.Text
  bodyHtml             String?              @db.Text
  scheduledAt          DateTime?
  submittedAt          DateTime?
  deliveredAt          DateTime?
  openedAt             DateTime?
  repliedAt            DateTime?
  sentAt               DateTime?
  receivedAt           DateTime?
  metadata             Json?
  bounceCategory       BounceCategory?
  failureReason        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  conversation       Conversation        @relation(fields: [conversationId], references: [id])
  company            Company?            @relation(fields: [companyId], references: [id])
  contact            Contact?            @relation(fields: [contactId], references: [id])
  connection         ChannelConnection?  @relation(fields: [connectionId], references: [id])
  sequenceEnrollment SequenceEnrollment? @relation(fields: [sequenceEnrollmentId], references: [id])
  sequenceStep       SequenceStep?       @relation(fields: [sequenceStepId], references: [id])
  recipients         MessageRecipient[]
  attachments        Attachment[]
  events             MessageEvent[]
  approval           ApprovalRequest?
  schedule           ScheduledMessage?
  inboundReview      InboundReview?
  replyIntelligence  ReplyIntelligence?
  recommendedActions RecommendedAction[]
  objections         ConversationObjection[]
  meetingIntent      MeetingIntent?
  suggestedReplies   SuggestedReply[]             @relation("SuggestedReplySourceMessage")
  salesTasks         SalesTask[]
  aiRuns             AiRun[]

  @@unique([connectionId, providerMessageId])
  @@index([companyId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status, scheduledAt])
}

model MessageRecipient {
  id                String              @id @default(cuid())
  messageId         String
  contactId         String?
  type              RecipientType
  address           String
  normalizedAddress String
  contactability    ContactabilityState @default(UNKNOWN)
  createdAt         DateTime            @default(now())

  message   Message  @relation(fields: [messageId], references: [id])
  contact   Contact? @relation(fields: [contactId], references: [id])

  @@unique([messageId, type, normalizedAddress])
  @@index([normalizedAddress])
}

model Attachment {
  id           String               @id @default(cuid())
  messageId    String
  providerId   String?
  fileName     String
  originalName String?
  mimeType     String
  sizeBytes    Int
  storageKey   String?
  sha256       String?
  scanStatus   AttachmentScanStatus @default(PENDING)
  scanDetails  String?
  contentId    String?
  isInline     Boolean              @default(false)
  createdAt    DateTime             @default(now())

  message Message @relation(fields: [messageId], references: [id])

  @@index([sha256])
  @@index([scanStatus, createdAt])
}

model MessageEvent {
  id              String           @id @default(cuid())
  messageId       String
  type            MessageEventType
  providerEventId String?
  occurredAt      DateTime         @default(now())
  metadata        Json?
  createdAt       DateTime         @default(now())

  message Message @relation(fields: [messageId], references: [id])

  @@unique([messageId, providerEventId])
  @@index([messageId, occurredAt])
}

model MessageTemplate {
  id           String               @id @default(cuid())
  name         String
  category     TemplateCategory
  channel      CommunicationChannel
  subject      String?
  body         String               @db.Text
  variables    String[]
  approvalMode ApprovalMode         @default(REQUIRED)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model ScheduledMessage {
  id             String         @id @default(cuid())
  messageId      String         @unique
  dueAt          DateTime
  recipientTimezone String       @default("UTC")
  queueJobId     String?
  status         ScheduleStatus @default(PENDING)
  validationHash String?
  lastError      String?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  message Message @relation(fields: [messageId], references: [id])

  @@index([status, dueAt])
}

model InboundReview {
  id                    String              @id @default(cuid())
  messageId             String              @unique
  connectionId          String
  senderAddress         String
  senderName            String?
  subject               String?
  providerThreadId      String?
  status                InboundReviewStatus @default(PENDING)
  possibleMatches       Json?
  matchConfidence       Int                 @default(0)
  matchReason           String?
  resolution            String?
  resolvedCompanyId     String?
  resolvedContactId     String?
  resolvedAt            DateTime?
  resolvedBy            String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  message           Message           @relation(fields: [messageId], references: [id])
  connection        ChannelConnection @relation(fields: [connectionId], references: [id])
  resolvedCompany   Company?          @relation("InboundReviewCompany", fields: [resolvedCompanyId], references: [id])
  resolvedContact   Contact?          @relation("InboundReviewContact", fields: [resolvedContactId], references: [id])

  @@index([status, createdAt])
  @@index([senderAddress])
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  messageId   String         @unique
  status      ApprovalStatus @default(PENDING)
  reason      String?
  riskFlags   String[]
  requestedAt DateTime       @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  reviewNote  String?

  message Message @relation(fields: [messageId], references: [id])

  @@index([status, requestedAt])
}

model SuppressionEntry {
  id                    String               @id @default(cuid())
  channel               CommunicationChannel
  scope                 SuppressionScope
  normalizedDestination String?
  companyId             String?
  contactId             String?
  domain                String?
  reason                SuppressionReason
  details               String?
  active                Boolean              @default(true)
  createdAt             DateTime             @default(now())
  revokedAt             DateTime?

  company   Company? @relation(fields: [companyId], references: [id])
  contact   Contact? @relation(fields: [contactId], references: [id])

  @@index([channel, normalizedDestination, active])
  @@index([companyId, active])
  @@index([domain, active])
}

model Sequence {
  id                     String               @id @default(cuid())
  connectionId           String?
  name                   String
  channel                CommunicationChannel
  status                 SequenceStatus       @default(DRAFT)
  approvalMode           ApprovalMode         @default(REQUIRED)
