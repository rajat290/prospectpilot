{
  "name": "prospectpilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Internal-first revenue intelligence platform for turning public business sources into qualified sales opportunities.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:workers": "npm run dev --workspace apps/workers",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "seed:demo": "tsx prisma/seed.ts",
    "cleanup:contacts": "tsx prisma/cleanup-contacts.ts",
    "backfill:spine": "tsx prisma/backfill-lead-spine.ts",
    "seed:communications": "tsx prisma/seed-communications.ts",
    "prepare:founding-pilot": "tsx scripts/prepare-founding-pilot.ts",
    "setup:communication-secrets": "tsx scripts/setup-communication-secrets.ts",
    "dev:all": "concurrently -n WEB,API,WORKER -c green,blue,yellow \"npm run dev\" \"npm run dev:api\" \"npm run dev:workers\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "concurrently": "^9.0.1",
    "prisma": "^5.16.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
